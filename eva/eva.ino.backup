// ============================================================
// Audio & Memory Configuration
// ============================================================

static constexpr int     SAMPLE_RATE     = 16000;
static constexpr size_t  RING_SIZE       = 32768;
static constexpr size_t  PLAY_CHUNK      = 1024;
static constexpr size_t  MIC_CHUNK       = 1600; // 100ms at 16kHz
static constexpr size_t  WORK_BUF_SIZE   = 32768;

static int16_t* ring             = nullptr;
static uint8_t* work_buf         = nullptr;
static int16_t* mic_buf          = nullptr;
static int16_t  tbuf[3][PLAY_CHUNK];

static volatile size_t ring_w = 0, ring_r = 0, tbuf_idx = 0;
static unsigned long last_play_ms = 0;

static void app_mem_init() {
    ring = (int16_t*)heap_caps_malloc(RING_SIZE * sizeof(int16_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    mic_buf = (int16_t*)heap_caps_malloc(MIC_CHUNK * sizeof(int16_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    uint32_t caps = psramFound() ? (MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) : (MALLOC_CAP_8BIT);
    work_buf = (uint8_t*)heap_caps_malloc(WORK_BUF_SIZE, caps);

    if (!ring || !mic_buf || !work_buf) {
        Serial.println("[MEM] CRITICAL error");
        while(1) delay(1000);
    }
}

static size_t ring_avail() {
    size_t w = ring_w, r = ring_r;
    return (w >= r) ? (w - r) : (RING_SIZE - r + w);
}

static void ring_flush() {
    ring_w = ring_r = 0;
}

// ============================================================
// Hardware Audio Controls
// ============================================================

static void spk_on() {
    Serial.println("[HW] Speaker starting...");
    M5.Mic.end();
    delay(50); // Settle time
    ring_flush();
    tbuf_idx = 0;
    M5.Speaker.begin();
    M5.Speaker.setVolume(SOUND_VOLUME);
}

static void spk_off() {
    M5.Speaker.stop();
    M5.Speaker.end();
    Serial.println("[HW] Speaker stopped.");
}

static void play_chime() {
    spk_on();
    M5.Speaker.setVolume(50);
    M5.Speaker.tone(1109, 60); delay(60);
    M5.Speaker.tone(1519, 80); delay(80);
    M5.Speaker.stop();
    spk_off();
    M5.Speaker.setVolume(SOUND_VOLUME);
}

static void spk_push(const int16_t* buffer, size_t sample_count) {
    for (size_t i = 0; i < sample_count; i++) {
        size_t next_w = (ring_w + 1) % RING_SIZE;
        if (next_w == ring_r) break;
        ring[ring_w] = buffer[i];
        ring_w = next_w;
    }
}

static void spk_drain() {
    while (ring_avail() > 0 && M5.Speaker.isPlaying(0) < 2) {
        size_t n = min(ring_avail(), PLAY_CHUNK);
        for (size_t i = 0; i < n; i++) {
            tbuf[tbuf_idx][i] = ring[ring_r];
            ring_r = (ring_r + 1) % RING_SIZE;
        }
        M5.Speaker.playRaw(tbuf[tbuf_idx], n, SAMPLE_RATE, false, 1, 0);
        tbuf_idx = (tbuf_idx + 1) % 3;
        last_play_ms = millis(); // Track physical playback time
    }
}

// ============================================================
// Network & Conversation State
// ============================================================

enum State { IDLE, CONNECTING, WAIT_METADATA, STREAMING, SPEAKING };
static State state = IDLE;

WebsocketsClient ws;
static unsigned long last_voice_ms = 0;
static unsigned long last_audio_ms = 0;

static void start_listening() {
    if (state != STREAMING) {
        Serial.println("[HW] Mic starting...");
        spk_off();
        delay(50); // Settle time
        state = STREAMING;
        M5.Mic.begin();
        term_show_prompt("> listening...");
    }
}

static void send_audio_chunk(const int16_t* samples, size_t count) {
    static char msg_buf[16384];
    const char prefix[] = "{\"user_audio_chunk\":\"";
    const char suffix[] = "\"}";
    strcpy(msg_buf, prefix);
    size_t b64_len = 0;
    mbedtls_base64_encode((unsigned char*)&msg_buf[strlen(prefix)], sizeof(msg_buf) - strlen(prefix) - 5, &b64_len, (const unsigned char*)samples, count * 2);
    strcat(msg_buf, suffix);
    ws.send(msg_buf);
}

static void on_message(WebsocketsMessage msg) {
    const char* json = msg.rawData().c_str();
    size_t length = msg.length();

    if (strstr(json, "\"audio\"")) {
        JsonDocument doc;
        if (deserializeJson(doc, json, length)) return;

        const char* b64 = doc["audio_event"]["audio_base_64"];
        if (b64) {
            size_t out_len = 0;
            if (mbedtls_base64_decode(work_buf, WORK_BUF_SIZE, &out_len, (const unsigned char*)b64, strlen(b64)) == 0) {
                if (state != SPEAKING) {
                    state = SPEAKING;
                    spk_on();
                }
                last_audio_ms = last_voice_ms = millis();
                spk_push((const int16_t*)work_buf, out_len / 2);
            }
        }
        return;
    }

    JsonDocument doc;
    if (deserializeJson(doc, json, length)) return;
    const char* type = doc["type"];
    if (type) Serial.printf("[WS] Type: %s\n", type);

    if (type && strcmp(type, "conversation_initiation_metadata") == 0) {
        Serial.println("[EVA] Handshake OK");
        term_print("[EVA] handshake OK");
        start_listening();
        last_voice_ms = millis();
    } else if (type && strcmp(type, "vad_score") == 0) {
        float score = doc["vad_score_event"]["vad_score"] | 0.0f;
        if (score > 0.5) Serial.printf("[VAD] %.2f\n", score);
    } else if (type && strcmp(type, "interruption") == 0) {
        Serial.println("[EVA] Interrupted!");
        term_print("[EVA] interrupted");
        ring_flush();
        start_listening();
    } else if (type && strcmp(type, "agent_response") == 0) {
        const char* txt = doc["agent_response_event"]["agent_response"];
        if (txt) {
            Serial.printf("[AGENT] %s\n", txt);
            char disp[42];
            snprintf(disp, sizeof(disp), "> %s", txt);
            term_print(disp);
        }
    } else if (type && strcmp(type, "ping") == 0) {
        int eid = doc["ping_event"]["event_id"] | 0;
        char resp[64];
        snprintf(resp, sizeof(resp), "{\"type\":\"pong\",\"event_id\":%d}", eid);
        ws.send(resp);
    } else if (type) {
        // Log unhandled event types with full payload (truncated)
        Serial.printf("[WS] Unhandled type=%s payload=%.200s\n", type, json);
    } else {
        Serial.printf("[WS] Unknown msg (no type): %.200s\n", json);
    }
}

static void on_event(WebsocketsEvent event, String data) {
    if (event == WebsocketsEvent::ConnectionOpened) {
        Serial.println("[WS] Opened");
        term_print("[WS] connected");
        ws.send("{\"type\":\"conversation_initiation_client_data\",\"conversation_config_override\":{\"agent\":{\"user_input_audio_format\":\"pcm_16000\",\"agent_output_audio_format\":\"pcm_16000\"}}}");
    } else if (event == WebsocketsEvent::ConnectionClosed) {
        Serial.printf("[WS] Closed: %s\n", data.c_str());
        term_print("[WS] disconnected");
        state = IDLE;
        spk_off();
        M5.Mic.end();
        term_show_prompt("> press A to start");
    }
}

void setup() {
    auto cfg = M5.config();
    cfg.external_speaker.hat_spk2 = true;
    cfg.internal_mic = true;
    M5.begin(cfg);

    Serial.begin(115200);
    delay(2000);
    Serial.println("\n--- EVA STARTUP ---");

    M5.Display.setRotation(1);
    M5.Display.fillScreen(TFT_BLACK);

    app_mem_init();

    // CONFIGURE MIC RATE ONCE
    auto mic_cfg = M5.Mic.config();
    mic_cfg.sample_rate = 16000;
    mic_cfg.dma_buf_len = 1600;
    mic_cfg.dma_buf_count = 2;
    M5.Mic.config(mic_cfg);

    play_chime();
    startup_animation();

    term_init();
    term_print("[SYS] EVA v1.0 booting...");

    WiFi.begin(WIFI_SSID, WIFI_PASS);
    term_print("[WIFI] connecting...");
    while (WiFi.status() != WL_CONNECTED) delay(500);
    Serial.println("[WIFI] OK");
    term_print("[WIFI] ok");

    configTime(0, 0, "pool.ntp.org", "time.nist.gov");
    struct tm timeinfo;
    if (getLocalTime(&timeinfo)) {
        Serial.println(&timeinfo, "[TIME] OK: %A, %B %d %Y %H:%M:%S");
        char tbuf[42];
        strftime(tbuf, sizeof(tbuf), "[TIME] %a %H:%M:%S", &timeinfo);
        term_print(tbuf);
    }

    ws.onMessage(on_message);
    ws.onEvent(on_event);
    ws.setCACert(ssl_ca_cert);

    term_show_prompt("> press A to start");
}

void loop() {
    M5.update();
    if (state != IDLE) ws.poll();

    if (M5.BtnA.wasPressed()) {
        if (state == IDLE) {
            Serial.println("[EVA] Connecting...");
            term_print("[EVA] connecting...");
            term_show_prompt("> connecting...");
            state = CONNECTING;
            ws.addHeader("xi-api-key", ELEVENLABS_API_KEY);
            ws.addHeader("Origin", "https://elevenlabs.io");
            String url = "wss://api.elevenlabs.io/v1/convai/conversation?agent_id=";
            url += ELEVENLABS_AGENT_ID;
            ws.connect(url);
        } else {
            ws.close();
        }
    }

    if (state == STREAMING) {
        // record() blocks until MIC_CHUNK samples are filled (100ms at 16kHz)
        if (M5.Mic.record(mic_buf, MIC_CHUNK, SAMPLE_RATE)) {
            static unsigned long last_voice_at = 0;
            static bool is_transmitting = false;
            static unsigned long last_chunk_log = 0;

            int16_t chunk_peak = 0;
            for (size_t i = 0; i < MIC_CHUNK; i++) {
                int16_t abs_val = abs(mic_buf[i]);
                if (abs_val > chunk_peak) chunk_peak = abs_val;
            }

            if (millis() - last_chunk_log > 500) {
                Serial.printf("[CHUNK] peak=%d %s\n", chunk_peak, chunk_peak > 1000 ? "VOICE" : "silence");
                last_chunk_log = millis();
            }

            if (chunk_peak > 1000) {
                if (!is_transmitting) Serial.println("[VAD] Voice started");
                is_transmitting = true;
                last_voice_at = millis();
            }

            if (is_transmitting) {
                if (millis() - last_voice_at < 2000) {
                    send_audio_chunk(mic_buf, MIC_CHUNK);
                } else {
                    Serial.println("[VAD] Voice stopped (2s silence)");
                    is_transmitting = false;
                }
            }
        }
    } else if (state == SPEAKING) {
        spk_drain();

        // Wait at least 2 seconds after receiving AND playing audio
        if (millis() - last_audio_ms > 2000 && millis() - last_play_ms > 2000 && ring_avail() == 0 && M5.Speaker.isPlaying(0) == 0) {
            Serial.println("[EVA] Speech finished. Resuming mic.");
            term_print("[EVA] speech done");
            start_listening();
        }
    }
    delay(1);
}
